# You normally don't need to edit this file: the setup wizard creates .env for you on first run
# (or run `npm run setup`). Keep .env private; it is listed in .gitignore.

# Optional. If empty, the tool asks for the key (hidden) each time it starts. Safer.
PRIVATE_KEY=

# Required. Free key from https://dev.blockscout.com (about 30 seconds, no card). Used to find your tokens.
BLOCKSCOUT_API_KEY=

# Optional. Pre-filled as the destination for Transfer and Sell & sweep.
DESTINATION_ADDRESS=

# Advanced: only change these to use a private RPC provider or a different chain.
# RPC_URL=https://rpc.mainnet.chain.robinhood.com
# CHAIN_ID=4663
# EXPLORER_URL=https://robin.etherscan.io
