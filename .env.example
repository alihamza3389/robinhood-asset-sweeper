# ===================================================
# Robinhood Chain (Arbitrum Orbit L2) Batch Sender
# ===================================================

# 1. Your Sender Wallet Private Key (Must start with 0x)
PRIVATE_KEY=0x_your_private_key_here

# 2. Destination Address to receive all assets
DESTINATION_ADDRESS=0x_recipient_address_here

# 3. Blockscout Pro API Key (from https://dev.blockscout.com/)
BLOCKSCOUT_API_KEY=your_blockscout_pro_key_here

# 4. Robinhood Chain Pre-configured Network Settings
# (Leave as-is unless using a private RPC provider like Alchemy/QuickNode)
CHAIN_ID=4663
CHAIN_NAME=Robinhood Chain
RPC_URL=https://rpc.mainnet.chain.robinhood.com
EXPLORER_URL=https://robinhoodchain.blockscout.com
BLOCKSCOUT_API_URL=https://robinhoodchain.blockscout.com/api/v2
NATIVE_CURRENCY_SYMBOL=ETH
NATIVE_CURRENCY_DECIMALS=18
